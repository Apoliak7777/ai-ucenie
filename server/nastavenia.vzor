# Nastavenia rezervačného backendu.
# Skopíruj tento súbor ako nastavenia.env (do toho istého priečinka) a vyplň.
# nastavenia.env je v .gitignore — heslo sa do repa nikdy nedostane.

# Schránka, z ktorej odchádzajú potvrdenia (Hostinger).
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_UZIVATEL=info@aiucenie.online
SMTP_HESLO=

# Kam chodia nové rezervácie.
MOJ_MAIL=info@aiucenie.online

# Voliteľné.
ZNACKA=AI Učenie
WEB=aiucenie.online
PORT=8787
