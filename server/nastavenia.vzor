# Nastavenia API rezervácií na VPS.
# Inštalátor (instaluj.sh) si tento súbor skopíruje ako nastavenia.env a doplní heslá.
# nastavenia.env je v .gitignore — heslá sa do repa nikdy nedostanú.

# Schránka, z ktorej odchádzajú potvrdenia (Hostinger).
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_UZIVATEL=info@aiucenie.online
SMTP_HESLO=

# Kam chodia nové rezervácie.
MOJ_MAIL=info@aiucenie.online

# Heslo do /admin na stránke.
ADMIN_HESLO=

# Voliteľné.
ZNACKA=AI Učenie
WEB=aiucenie.online
PORT=8787
