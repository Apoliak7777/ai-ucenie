{
  "name": "ai-ucenie",
  "private": true,
  "description": "aiucenie.online — statická stránka + rezervačné Functions pre Cloudflare Pages",
  "scripts": {
    "api:dev": "wrangler dev -c worker/wrangler.toml --port 8787 --ip 127.0.0.1",
    "api:deploy": "wrangler deploy -c worker/wrangler.toml",
    "api:logs": "wrangler tail -c worker/wrangler.toml",
    "dev": "wrangler pages dev . --d1 DB --compatibility-date 2026-09-01 --port 8788 --ip 127.0.0.1"
  },
  "dependencies": {
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "allowScripts": {
    "workerd@1.20260911.1": true
  }
}
